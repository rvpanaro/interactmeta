#!/usr/bin/env bash
# Version-controlled pre-commit hook for interactmeta.
# Install: cp tools/git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -euo pipefail

root="$(git rev-parse --show-toplevel)"
"$root/tools/check-no-prompt-artifacts.sh"

README=($(git diff --cached --name-only | grep -Ei '^README\.[R]?md$' || true))
MSG="use 'git commit --no-verify' to override this check"

if [[ ${#README[@]} == 0 ]]; then
  exit 0
fi

if [[ README.Rmd -nt README.md ]]; then
  echo -e "README.md is out of date; please re-knit README.Rmd\n$MSG"
  exit 1
elif [[ ${#README[@]} -lt 2 ]]; then
  echo -e "README.Rmd and README.md should be both staged\n$MSG"
  exit 1
fi

exit 0
